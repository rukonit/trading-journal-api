// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String?
  accounts String[]
  address Address?
  trades Trade[]
}

model Address {
  id      Int     @id @default(autoincrement())
  street1 String
  street2 String?
  city    String
  zipCode String
  country String
  userId  Int     @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trade {
  id Int @id @default(autoincrement())
  account String
  executedAt DateTime
  currency String
  type Int
  commodityType CommodityType
  eventType EventType
  quantity Int
  price Float
  commission Float
  fee Float
  email String
  user User @relation(fields: [email], references: [email])
  source String
}

enum CommodityType {
  EQUITY
  OPTION
  FUTURE
  FOREX
  CRYPTO
}

enum EventType {
  BUY
  SELL
  SHORT
  COVER
  DIVIDEND
  INTEREST
  FEE
  DEPOSIT
  WITHDRAWAL
}